{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Top-level configuration
  "name": "bmc-docs-prd",
  // Set this to today's date
  "compatibility_date": "2026-07-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  }
}
